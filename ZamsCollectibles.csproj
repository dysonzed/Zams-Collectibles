<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZamsCollectibles</AssemblyName>
    <RootNamespace>ZamsCollectibles</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Where the game is installed. -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <ModInstallDir>$(GameDir)\Mods\ZamsCollectibles</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Files that ship with the mod besides the DLL: the manifest and the asset folders. -->
  <ItemGroup>
    <ModFile Include="manifest.xml;preview.png;Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
    <None Remove="Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
  </ItemGroup>

  <!-- After every build, install the mod into <game>\Mods\ZamsCollectibles\ so the game picks it up. -->
  <Target Name="InstallMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModInstallDir)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('%(ModFile.FullPath)')" />
    <Message Importance="high" Text="Installed into $(ModInstallDir)" />
  </Target>

</Project>
